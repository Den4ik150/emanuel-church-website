# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in all required values
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────────

# Local development (PostgreSQL)
DATABASE_URL="postgresql://USER@localhost:5432/emmanuil_church_dev"

# Production — use a managed Postgres provider (Supabase, Neon, Railway, etc.)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# ── NextAuth / Auth ──────────────────────────────────────────────────────────

# Random secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"

# Full URL of the app (no trailing slash)
# Local:
NEXTAUTH_URL="http://localhost:3000"
# Production:
# NEXTAUTH_URL="https://your-domain.com"
