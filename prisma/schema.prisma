generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Admin ───────────────────────────────────────────────────────────────────

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── Static Pages ─────────────────────────────────────────────────────────────

model StaticPage {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  excerpt        String?
  content        String
  seoTitle       String?
  seoDescription String?
  isPublished    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ─── Sermons ──────────────────────────────────────────────────────────────────

model Sermon {
  id               String   @id @default(cuid())
  title            String
  topic            String?
  preacher         String
  description      String?
  sermonDate       DateTime
  thumbnailUrl     String?
  videoUrl         String
  timestampSeconds Int?
  notesUrl         String?
  isPublished      Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ─── Events ───────────────────────────────────────────────────────────────────

model Event {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  description    String?
  eventDate      DateTime
  eventTimeLabel String?
  location       String?
  imageUrl       String?
  isFeatured     Boolean  @default(false)
  isPublished    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ─── Schedule ─────────────────────────────────────────────────────────────────

model ScheduleItem {
  id           String   @id @default(cuid())
  title        String
  category     String?
  weekday      String
  startTime    String
  endTime      String?
  location     String?
  description  String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── News ─────────────────────────────────────────────────────────────────────

model NewsPost {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  excerpt       String?
  content       String
  coverImageUrl String?
  publishedAt   DateTime?
  isPublished   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ─── Gallery ──────────────────────────────────────────────────────────────────

model GalleryAlbum {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  description   String?
  albumDate     DateTime?
  coverImageUrl String?
  isPublished   Boolean       @default(false)
  items         GalleryItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model GalleryItem {
  id           String       @id @default(cuid())
  albumId      String
  album        GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  type         String       @default("photo")
  title        String?
  fileUrl      String
  thumbnailUrl String?
  description  String?
  displayOrder Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

// ─── Forms ────────────────────────────────────────────────────────────────────

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())
}

model PrayerRequest {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  message   String
  isPrivate Boolean  @default(true)
  status    String   @default("new")
  createdAt DateTime @default(now())
}

// ─── Settings ─────────────────────────────────────────────────────────────────

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  group     String?
  updatedAt DateTime @updatedAt
}
